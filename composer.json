{
    "name": "tobiashaas/woocommerce-percentage-shipping",
    "description": "Calculate shipping costs as a percentage of physical products",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Tobias Haas",
            "email": "tobias@example.com"
        }
    ],
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "yoast/phpunit-polyfills": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "WC_Percentage_Shipping\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WC_Percentage_Shipping_Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html tests/coverage",
        "test-watch": "phpunit --watch"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
